\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces PC1 $R^2$, helix $R^2$ and helix/PCA ratio plotted against layer index, for each of the five models (Latin digits 0--99). Pythia and Llama rise into the back half of the stack and stay high. Gemma-4-E4B peaks early and decays. Gemma-4-31B is nearly flat at $\sim $0.5 with a sharp spike at $L\!=\!29$ that reads as ``no helix'' if one samples at $L \!=\! 30 = N/2$. OLMo-3-32B rises gradually to a mid-stack helix at $L\!=\!23$, with a separate early peak in the helix/PCA ratio at $L\!=\!4$ that mirrors the Gemma-4-E4B early-helix pattern.}}{14}{figure.caption.5}\protected@file@percent }
\newlabel{fig:layer-sweep}{{1}{14}{PC1 $R^2$, helix $R^2$ and helix/PCA ratio plotted against layer index, for each of the five models (Latin digits 0--99). Pythia and Llama rise into the back half of the stack and stay high. Gemma-4-E4B peaks early and decays. Gemma-4-31B is nearly flat at $\sim $0.5 with a sharp spike at $L\!=\!29$ that reads as ``no helix'' if one samples at $L \!=\! 30 = N/2$. OLMo-3-32B rises gradually to a mid-stack helix at $L\!=\!23$, with a separate early peak in the helix/PCA ratio at $L\!=\!4$ that mirrors the Gemma-4-E4B early-helix pattern}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Pythia-6.9B on Roman numerals. \textbf  {Top}: FFT spectrum shows clean peaks at $T = 10$ (X cycle) and $T = 5$ (V cycle)---the visual periodicity of the additive system. \textbf  {Bottom}: PC1 versus $a$ is a piecewise function with jumps at the Roman threshold values, not a line. The two components live in different layers (Table~\ref {tab:script-collapse}).}}{15}{figure.caption.13}\protected@file@percent }
\newlabel{fig:roman}{{2}{15}{Pythia-6.9B on Roman numerals. \textbf {Top}: FFT spectrum shows clean peaks at $T = 10$ (X cycle) and $T = 5$ (V cycle)---the visual periodicity of the additive system. \textbf {Bottom}: PC1 versus $a$ is a piecewise function with jumps at the Roman threshold values, not a line. The two components live in different layers (Table~\ref {tab:script-collapse})}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Pythia-6.9B on Greek alphabetic numerals. The FFT magnitude is two orders of magnitude smaller than on Latin; the only periodic structure is a $T=10$ artifact at $L=0$ from the alphabetic construction $\kappa + \gamma = $ \(\kappa \gamma \). PC1 $R^2 = 0.004$: the model is not representing Greek numerals as quantities.}}{16}{figure.caption.15}\protected@file@percent }
\newlabel{fig:greek}{{3}{16}{Pythia-6.9B on Greek alphabetic numerals. The FFT magnitude is two orders of magnitude smaller than on Latin; the only periodic structure is a $T=10$ artifact at $L=0$ from the alphabetic construction $\kappa + \gamma = $ \(\kappa \gamma \). PC1 $R^2 = 0.004$: the model is not representing Greek numerals as quantities}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Pythia-6.9B on Roman numerals. 2D PCA at the helix-peak layer reveals discrete clusters by Roman-numeral prefix (I/V, X, L, XC), with the trajectory line zigzagging at threshold integers. The representation is a partition, not a continuous manifold.}}{17}{figure.caption.16}\protected@file@percent }
\newlabel{fig:roman_pca}{{4}{17}{Pythia-6.9B on Roman numerals. 2D PCA at the helix-peak layer reveals discrete clusters by Roman-numeral prefix (I/V, X, L, XC), with the trajectory line zigzagging at threshold integers. The representation is a partition, not a continuous manifold}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Gemma-4-31B on Latin digits. PC1 captures 70.9\% of variance but separates the points by \emph  {token shape} (single-digit vs.~teens vs.~20--99), not magnitude. Helix $R^2 = 0.70$ persists at this layer, in lower-variance directions PC1 does not reach.}}{18}{figure.caption.17}\protected@file@percent }
\newlabel{fig:gemma_latin_pca}{{5}{18}{Gemma-4-31B on Latin digits. PC1 captures 70.9\% of variance but separates the points by \emph {token shape} (single-digit vs.~teens vs.~20--99), not magnitude. Helix $R^2 = 0.70$ persists at this layer, in lower-variance directions PC1 does not reach}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Gemma-4-31B on Babylonian at $n_{\max }=100$. Top FFT shows $T=10$ and $T=100$; \emph  {no} $T=60$. PC1 (bottom) shows numbers 0--59 versus 60--99 as two clusters with a step between them.}}{19}{figure.caption.19}\protected@file@percent }
\newlabel{fig:bab-n100}{{6}{19}{Gemma-4-31B on Babylonian at $n_{\max }=100$. Top FFT shows $T=10$ and $T=100$; \emph {no} $T=60$. PC1 (bottom) shows numbers 0--59 versus 60--99 as two clusters with a step between them}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Pythia-6.9B on Babylonian at $n_{\max }=600$. A clean labelled peak at $T \approx 60$ appears alongside $T = 10$ and various harmonics. The PC1 panel shows the magnitude axis with a per-column sawtooth---the model resets into a new sexagesimal column every 60 integers.}}{19}{figure.caption.21}\protected@file@percent }
\newlabel{fig:bab-n600-pythia}{{7}{19}{Pythia-6.9B on Babylonian at $n_{\max }=600$. A clean labelled peak at $T \approx 60$ appears alongside $T = 10$ and various harmonics. The PC1 panel shows the magnitude axis with a per-column sawtooth---the model resets into a new sexagesimal column every 60 integers}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Gemma-4-31B on Babylonian at $n_{\max }=600$. Base-60 structure manifests primarily through its second harmonic at $T=30$, indicating a sawtooth-like signal rather than a pure sinusoid.}}{20}{figure.caption.22}\protected@file@percent }
\newlabel{fig:bab-n600-gemma}{{8}{20}{Gemma-4-31B on Babylonian at $n_{\max }=600$. Base-60 structure manifests primarily through its second harmonic at $T=30$, indicating a sawtooth-like signal rather than a pure sinusoid}{figure.caption.22}{}}
