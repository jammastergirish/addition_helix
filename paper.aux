\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Layer of peak PC1 and helix $R^2$ on Latin, Roman, Greek. Latin: both peak at the same layer (a single helix). Roman: peaks are 9--20 layers apart (decomposed parallel modules). Greek: helix $R^2$ peaks at $L=0$ (tokeniser artifact at the embedding).}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:script-collapse}{{4}{7}{Layer of peak PC1 and helix $R^2$ on Latin, Roman, Greek. Latin: both peak at the same layer (a single helix). Roman: peaks are 9--20 layers apart (decomposed parallel modules). Greek: helix $R^2$ peaks at $L=0$ (tokeniser artifact at the embedding)}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Pythia-6.9B on Roman numerals. \textbf  {Top}: FFT spectrum shows clean peaks at $T = 10$ (X cycle) and $T = 5$ (V cycle)---the visual periodicity of the additive system. \textbf  {Bottom}: PC1 versus $a$ is a piecewise function with jumps at the Roman threshold values, not a line. The two components live in different layers (Table~\ref {tab:script-collapse}).}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:roman}{{2}{7}{Pythia-6.9B on Roman numerals. \textbf {Top}: FFT spectrum shows clean peaks at $T = 10$ (X cycle) and $T = 5$ (V cycle)---the visual periodicity of the additive system. \textbf {Bottom}: PC1 versus $a$ is a piecewise function with jumps at the Roman threshold values, not a line. The two components live in different layers (Table~\ref {tab:script-collapse})}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {paragraph}{Greek: no quantitative representation at all.}{7}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Pythia-6.9B on Greek alphabetic numerals. The FFT magnitude is two orders of magnitude smaller than on Latin; the only periodic structure is a $T=10$ artifact at $L=0$ from the alphabetic construction $\kappa + \gamma = $ \(\kappa \gamma \). PC1 $R^2 = 0.004$: the model is not representing Greek numerals as quantities.}}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:greek}{{3}{8}{Pythia-6.9B on Greek alphabetic numerals. The FFT magnitude is two orders of magnitude smaller than on Latin; the only periodic structure is a $T=10$ artifact at $L=0$ from the alphabetic construction $\kappa + \gamma = $ \(\kappa \gamma \). PC1 $R^2 = 0.004$: the model is not representing Greek numerals as quantities}{figure.caption.15}{}}
